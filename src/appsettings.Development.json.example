  },
  "Jwt": {
    "Issuer": "deutchezz-hotel",
    "Audience": "deutchezz-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "Key": "dev-only-change-me-32-characters-minimum-000000"
  },
  "Seed": {
    "AdminEmail": "REPLACE_ME_ADMIN@example.com",
    "AdminPassword": "REPLACE_ME_ADMIN_123",
