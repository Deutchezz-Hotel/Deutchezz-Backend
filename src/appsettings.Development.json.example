    "ReceptionistPassword": "REPLACE_ME_RECEPTIONIST_123",
    "CustomerEmail": "REPLACE_ME_CUSTOMER@example.com",
    "CustomerPassword": "REPLACE_ME_CUSTOMER_123"
  },
  "Cancellation": { "WindowHours": 24 },
  "Settings": {
    "MaxRoomsPerBooking": 20,
    "CheckInTime": "14:00",
    "CheckOutTime": "12:00",
    "RequireFullPaymentAtCheckIn": false,
    "RequirePaymentBeforeCheckOut": false,
    "MaxStayNights": 30,
    "GraceHours": 2,
    "CheckOutReminderLeadMinutes": 30,
    "ReceptionNotificationEmails": ""
  },
  "Jobs": {
    "PendingExpiryIntervalMinutes": 15,
    "VerificationCleanupIntervalMinutes": 60,
    "CheckOutReminderIntervalMinutes": 5
  },
  "BookingRetention": {
    "Enabled": true,
    "CancelledDays": 30,
    "IntervalMinutes": 60
  },
  "Auth": {
    "CodeMinutes": 15,
    "ResendCooldownSeconds": 60,
    "MaxSendsPerHour": 5,
    "PendingRegistrationHours": 24,
    "MaxFailedAttempts": 5
  },
  "Security": {
    "OtpHmacKey": "dev-only-change-me-32-characters-minimum-111111"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://localhost:3000"]
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Otp": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Lookup": { "PermitLimit": 5, "WindowSeconds": 60 },
    "BookingCreate": { "PermitLimit": 10, "WindowSeconds": 60 },
