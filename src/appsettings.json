{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "deutchezz-hotel",
    "Audience": "deutchezz-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "Key": ""
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "Cancellation": {
    "WindowHours": 24
  },
  "Settings": {
    "MaxRoomsPerBooking": 20,
    "CheckInTime": "14:00",
    "CheckOutTime": "12:00",
    "RequireFullPaymentAtCheckIn": false,
    "RequirePaymentBeforeCheckOut": false
  },
  "Jobs": {
    "PendingExpiryIntervalMinutes": 15,
    "VerificationCleanupIntervalMinutes": 60
  },
  "Auth": {
    "CodeMinutes": 15,
    "ResendCooldownSeconds": 60,
    "MaxSendsPerHour": 5,
    "PendingRegistrationHours": 24,
    "MaxFailedAttempts": 5
  },
  "Security": {
    "OtpHmacKey": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Otp": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Lookup": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "BookingCreate": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Email": {
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "Deutchezz Hotel Ispahan"
    },
    "AdminNotificationAddress": "",
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  }
}
